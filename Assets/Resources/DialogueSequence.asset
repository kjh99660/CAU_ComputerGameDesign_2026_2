%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d785688d86bad45ba94f2a4147c1057a, type: 3}
  m_Name: DialogueSequence
  m_EditorClassIdentifier: GameDemo.Systems::DialogueSequenceData
  intro:
  - speaker: "\uB178\uC544"
    text: "\uD5C8\uBE0C \uC811\uC18D \uD655\uC778. \uBE44\uC0C1 \uC7AC\uBD80\uD305\uC744 \uC2DC\uC791\uD588\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uCD9C\uAD6C\uB294 \uC544\uC9C1 \uC7A0\uACA8 \uC788\uAD70."
    leftSpeaker: 0
  - speaker: "\uB178\uC544"
    text: "\uC544\uB974\uCE74\uAC00 \uB110 \uCD94\uC801 \uC911\uC774\uB77C \uC7A0\uAE34 \uAC70\uC57C. 100\uCD08 \uB4A4 \uD5C8\uBE0C\uAC00 \uC7AC\uBD80\uD305\uB418\uBA74 \uC5F4\uB824."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uB188\uB4E4 \uB85C\uBD07\uC740?"
    leftSpeaker: 0
  - speaker: "\uB178\uC544"
    text: "\uB124\uAC00 \uC9C0\uB2CC \uBAA8\uB4C8\uC744 \uB178\uB824. \uADF8\uAC8C \uC544\uB974\uCE74\uAC00 \uC9C0\uC6B4 \uC791\uC804 \uAE30\uB85D\uC758 \uB9C8\uC9C0\uB9C9 \uC0AC\uBCF8\uC774\uC57C."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uAE30\uB85D\uC740 \uC9C0\uD0A4\uACA0\uC5B4. \uB10C \uC7AC\uBD80\uD305\uC744 \uB05D\uB0B4."
    leftSpeaker: 0
  outro:
  - speaker: "\uB178\uC544"
    text: "\uC7AC\uBD80\uD305 \uC644\uB8CC. \uC774 \uAD6C\uC5ED\uC758 \uCD94\uC801 \uC815\uBCF4\uC640 \uACF5\uACA9 \uBA85\uB839\uC744 \uC9C0\uC6E0\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uB85C\uBD07\uB4E4\uC774 \uBA48\uCDC4\uAD70. \uC774\uC81C \uB098\uAC08 \uC218 \uC788\uB098?"
    leftSpeaker: 0
  - speaker: "\uB178\uC544"
    text: "\uCD9C\uAD6C\uAC00 \uC5F4\uB838\uC5B4. \uC678\uBD80\uB9DD\uC774 \uB2FF\uB294 \uACF3\uAE4C\uC9C0 \uAC00\uBA74 \uAE30\uB85D\uC744 \uACF5\uAC1C\uD560 \uC218 \uC788\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uC774\uBC88\uC5D4 \uC544\uB974\uCE74\uAC00 \uC544\uBB34\uAC83\uB3C4 \uC9C0\uC6B0\uAC8C \uB450\uC9C0 \uC54A\uACA0\uC5B4. \uB188\uB4E4 \uBC11\uC5D0\uC11C \uB0B4\uAC00 \uD55C \uC9D3\uAE4C\uC9C0."
    leftSpeaker: 0
  battleRadio:
  - remainingSeconds: 50
    speaker: "\uB178\uC544"
    text: "\uC808\uBC18 \uC9C0\uB0AC\uC5B4. \uACF5\uACA9 \uBA85\uB839\uC740 \uC544\uC9C1 \uC0B4\uC544 \uC788\uC5B4."
    leftSpeaker: 1
  - remainingSeconds: 10
    speaker: "\uB178\uC544"
    text: "10\uCD08 \uB0A8\uC558\uC5B4. \uBC84\uD168."
    leftSpeaker: 1
  outroManyHits:
  - speaker: "\uB178\uC544"
    text: "\uC7AC\uBD80\uD305 \uC644\uB8CC. \uC774 \uAD6C\uC5ED\uC758 \uCD94\uC801 \uC815\uBCF4\uC640 \uACF5\uACA9 \uBA85\uB839\uC744 \uC9C0\uC6E0\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uB85C\uBD07\uB4E4\uC774 \uBA48\uCDC4\uAD70."
    leftSpeaker: 0
  - speaker: "\uB178\uC544"
    text: "\uC804\uD22C \uB85C\uADF8 \uD655\uC778. \uB108 \uB9CE\uC774 \uB9DE\uC558\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uAE30\uB85D\uC740 \uBB34\uC0AC\uD574. \uADF8\uAC70\uBA74 \uB410\uC5B4."
    leftSpeaker: 0
  - speaker: "\uB178\uC544"
    text: "\uCD9C\uAD6C\uAC00 \uC5F4\uB838\uC5B4. \uC678\uBD80\uB9DD\uC774 \uB2FF\uB294 \uACF3\uAE4C\uC9C0 \uAC00\uBA74 \uAE30\uB85D\uC744 \uACF5\uAC1C\uD560 \uC218 \uC788\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uC774\uBC88\uC5D4 \uC544\uB974\uCE74\uAC00 \uC544\uBB34\uAC83\uB3C4 \uC9C0\uC6B0\uAC8C \uB450\uC9C0 \uC54A\uACA0\uC5B4. \uB188\uB4E4 \uBC11\uC5D0\uC11C \uB0B4\uAC00 \uD55C \uC9D3\uAE4C\uC9C0."
    leftSpeaker: 0
  outroPrecise:
  - speaker: "\uB178\uC544"
    text: "\uC7AC\uBD80\uD305 \uC644\uB8CC. \uC774 \uAD6C\uC5ED\uC758 \uCD94\uC801 \uC815\uBCF4\uC640 \uACF5\uACA9 \uBA85\uB839\uC744 \uC9C0\uC6E0\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uB85C\uBD07\uB4E4\uC774 \uBA48\uCDC4\uAD70."
    leftSpeaker: 0
  - speaker: "\uB178\uC544"
    text: "\uC804\uD22C \uB85C\uADF8 \uD655\uC778. \uC815\uBC00\uD55C \uC81C\uC555\uC774\uC5C8\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uC544\uB974\uCE74 \uBC11\uC5D0\uC11C\uB3C4 \uC774\uB9CC\uD07C \uC815\uBC00\uD588\uC9C0. \uD45C\uC801\uC774 \uB2EC\uB790\uC744 \uBFD0\uC774\uC57C."
    leftSpeaker: 0
  - speaker: "\uB178\uC544"
    text: "\uCD9C\uAD6C\uAC00 \uC5F4\uB838\uC5B4. \uC678\uBD80\uB9DD\uC774 \uB2FF\uB294 \uACF3\uAE4C\uC9C0 \uAC00\uBA74 \uAE30\uB85D\uC744 \uACF5\uAC1C\uD560 \uC218 \uC788\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uC774\uBC88\uC5D4 \uC544\uB974\uCE74\uAC00 \uC544\uBB34\uAC83\uB3C4 \uC9C0\uC6B0\uAC8C \uB450\uC9C0 \uC54A\uACA0\uC5B4. \uB188\uB4E4 \uBC11\uC5D0\uC11C \uB0B4\uAC00 \uD55C \uC9D3\uAE4C\uC9C0."
    leftSpeaker: 0
  manyHitsMinHits: 15
  preciseMaxHits: 3
  preciseMinKills: 200
