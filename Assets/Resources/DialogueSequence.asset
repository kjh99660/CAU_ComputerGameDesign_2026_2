--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d785688d86bad45ba94f2a4147c1057a, type: 3}
  m_Name: DialogueSequence
  m_EditorClassIdentifier: GameDemo.Systems::DialogueSequenceData
  intro:
  - speaker: "\uB178\uC544"
    text: "\uD5C8\uBE0C \uC811\uC18D \uD655\uC778. \uBE44\uC0C1 \uBCF5\uAD6C\uB97C \uC2DC\uC791\uD588\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uCD9C\uAD6C\uB294 \uC544\uC9C1 \uC7A0\uACA8 \uC788\uAD70."
    leftSpeaker: 0
  - speaker: "\uB178\uC544"
    text: "\uB124 \uC2DD\uBCC4 \uC815\uBCF4\uAC00 \uC218\uBC30 \uBA85\uB2E8\uC5D0 \uB0A8\uC544 \uC788\uC5B4. \uCD08\uAE30\uD654\uAE4C\uC9C0 100\uCD08\uAC00 \uD544\uC694\uD574."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uB188\uB4E4\uB3C4 \uB0B4\uAC00 \uC5EC\uAE30 \uC788\uB294 \uAC78 \uC54C\uC544\uCC58\uACA0\uC9C0."
    leftSpeaker: 0
  - speaker: "\uB178\uC544"
    text: "\uB85C\uBD07\uB4E4\uC774 \uB124 \uCABD\uC73C\uB85C \uC774\uB3D9\uD558\uACE0 \uC788\uC5B4. \uADF8 \uBAA8\uB4C8\uC744 \uBE7C\uC557\uAE30\uBA74 \uAE30\uB85D\uC740 \uC601\uC601 \uC0AC\uB77C\uC838."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uAE30\uB85D\uC740 \uC9C0\uD0A4\uACA0\uC5B4. \uB10C \uBCF5\uAD6C\uB97C \uB05D\uB0B4."
    leftSpeaker: 0
  outro:
  - speaker: "\uB178\uC544"
    text: "\uC7AC\uBD80\uD305 \uC644\uB8CC. \uC774 \uAD6C\uC5ED\uC758 \uCD94\uC801 \uC815\uBCF4\uC640 \uACF5\uACA9 \uBA85\uB839\uC744 \uC9C0\uC6E0\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uC774\uC81C \uB098\uAC08 \uC218 \uC788\uB098?"
    leftSpeaker: 0
  - speaker: "\uB178\uC544"
    text: "\uCD9C\uAD6C\uAC00 \uC5F4\uB838\uC5B4. \uC678\uBD80\uB9DD\uC5D0 \uB3C4\uCC29\uD558\uBA74 \uAE30\uB85D\uC744 \uACF5\uAC1C\uD560 \uC218 \uC788\uC5B4."
    leftSpeaker: 1
  - speaker: "K-7"
    text: "\uC774\uBC88\uC5D4 \uC800\uB4E4\uC774 \uAE30\uB85D\uC744 \uC9C0\uC6B0\uAC8C \uB450\uC9C0 \uC54A\uACA0\uC5B4."
    leftSpeaker: 0
